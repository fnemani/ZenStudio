// ============================================================================
// 🎮 WARZONE GPC PRO | PS5 DUALSENSE EDITION (VERSION 3.1 - FINAL BUILD)
// 🕹️ Layout: Stick & Bewegung (Stick & Move)
// ⚙️ Features: Zero-Lag Swap, Smart AA, Clamped Recoil, Aggressive Movement
// ============================================================================
// --- Globale Variablen ---
int current_weapon = 0; // Startet immer mit Profil 0 (MP)
int recoil_MP = 20;
int recoil_AR = 25;
int aim_assist = 1;
int active_recoil;
int final_recoil;

define DEADZONE = 10;

// ============================================================================
// 🎬 INITIALISIERUNG
// ============================================================================
init {
	// Setzt die LED-Farbe direkt beim Start auf Profil 1 (Blau)
	update_feedback();
}

// ============================================================================
// 🚀 MAIN LOGIC
// ============================================================================
main {
	// ------------------------------------------------------------------------
	// 1. Hair Triggers & Easy Sprint
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) > DEADZONE) {
		set_val(PS4_L2, 100);
	}

	if (get_val(PS4_R2) > DEADZONE) {
		set_val(PS4_R2, 100);
	}

	// Aggressiver Auto-Tac-Sprint: Löst L3 ab 40% Stick-Ausschlag nach vorne aus
	if (get_val(PS4_LY) < -40) {
		set_val(PS4_L3, 100);
	}

	// Auto-Breath (für Sniper-Loadouts)
	if (get_val(PS4_L2)) {
		set_val(PS4_L3, 100);
	}

	// ------------------------------------------------------------------------
	// 2. Zero-Lag Weapon Tracking (Manuell & Resync)
	// ------------------------------------------------------------------------
	// Resync (L2 halten + Dreieck) - Setzt lautlos auf MP (Blau) zurück
	if (get_val(PS4_L2) && event_press(PS4_TRIANGLE)) {
		current_weapon = 0;
		set_val(PS4_TRIANGLE, 0); // Blockiert In-Game Wechsel für sauberen Resync
		update_feedback();
	}
	// Normaler Waffenwechsel (nur Dreieck) - In-Game sofort ohne Delay
	else if (event_press(PS4_TRIANGLE)) {
		if (current_weapon == 0) {
			current_weapon = 1;
		}
		else {
			current_weapon = 0;
		}

		update_feedback();
	}

	// ------------------------------------------------------------------------
	// 3. Dynamic Clamped Anti-Recoil
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && get_val(PS4_R2)) {
		if (current_weapon == 0) {
			active_recoil = recoil_MP;
		}
		else {
			active_recoil = recoil_AR;
		}

		// Anti-Resistance für flüssiges manuelles Zielen nach unten
		if (abs(get_val(PS4_RY)) < active_recoil + 15) {
			final_recoil = get_val(PS4_RY) + active_recoil;

			// Clamping verhindert Engine-Bugs bei extremen Werten
			if (final_recoil > 100) {
				final_recoil = 100;
			}

			if (final_recoil < -100) {
				final_recoil = -100;
			}

			set_val(PS4_RY, final_recoil);
		}
	}

	// ------------------------------------------------------------------------
	// 4. Auto-Ping (Markiert Gegner beim ersten Schuss)
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && event_press(PS4_R2)) {
		combo_run(AutoPing);
	}

	// ------------------------------------------------------------------------
	// 5. Smart Aim Assist & Hip-Fire Boost
	// ------------------------------------------------------------------------
	if (aim_assist == 1) {
		// Normaler ADS Aim Assist (Pausiert kurz bei starken Flicks über 30%)
		if (get_val(PS4_L2) && abs(get_val(PS4_RX)) < 30 && abs(get_val(PS4_RY)) < 30) {
			combo_run(RotationalAA);
		}

		// Hip-Fire Strafe Assist (Nur R2 gedrückt) für CQC
		if (get_val(PS4_R2) && !get_val(PS4_L2)) {
			combo_run(HipfireStrafe);
		}
	}

	// ------------------------------------------------------------------------
	// 6. Aggressive Movement Systems
	// ------------------------------------------------------------------------
	// Slide Cancel in 3x B-Hop (Timings für Rebirth)
	if (event_press(PS4_CIRCLE) && get_val(PS4_LY) < -70) {
		combo_run(SlideCancelBHop);
	}

	// Insta-Drop-Shot (Gunfight R2 + Kreis)
	if (get_val(PS4_R2) && event_press(PS4_CIRCLE)) {
		combo_run(DropShot);
	}

	// Camera-Breaker (Aim loslassen während Gunfight)
	if (get_val(PS4_R2) && event_release(PS4_L2)) {
		combo_run(StrafeJump);
	}
}

// ============================================================================
// 🧠 FUNKTIONEN (LED FEEDBACK)
// ============================================================================
function update_feedback() {
	if (current_weapon == 0) {
		// Profil 1 (Primary/MP) -> Blaue LED
		set_led(LED_1, 1);
		set_led(LED_2, 0);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
	}
	else {
		// Profil 2 (Secondary/AR) -> Rote LED
		set_led(LED_1, 0);
		set_led(LED_2, 1);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
	}
}

// ============================================================================
// ⚡ COMBOS (EXECUTION)
// ============================================================================
combo AutoPing {
	set_val(PS4_UP, 100);
	wait(50);
	set_val(PS4_UP, 0);
	wait(50);
}

combo SlideCancelBHop {
	set_val(PS4_CIRCLE, 100);
	wait(80);
	set_val(PS4_CIRCLE, 0);
	wait(30);
	set_val(PS4_CIRCLE, 100);
	wait(50);
	set_val(PS4_CIRCLE, 0);
	wait(40);
	// B-Hops über R3 getriggert (Stick & Move Layout)
	set_val(PS4_R3, 100);
	wait(60);
	set_val(PS4_R3, 0);
	wait(60);
	set_val(PS4_R3, 100);
	wait(60);
	set_val(PS4_R3, 0);
	wait(60);
	set_val(PS4_R3, 100);
	wait(60);
	set_val(PS4_R3, 0);
}

combo StrafeJump {
	set_val(PS4_LX, 100);
	set_val(PS4_R3, 100);
	wait(80);
	set_val(PS4_R3, 0);
	wait(40);
}

combo DropShot {
	set_val(PS4_CIRCLE, 100);
	wait(350);
	set_val(PS4_CIRCLE, 0);
}

combo HipfireStrafe {
	set_val(PS4_LX, get_val(PS4_LX) + 20);
	wait(30);
	set_val(PS4_LX, get_val(PS4_LX) - 20);
	wait(30);
}

combo RotationalAA {
	set_val(PS4_RX, get_val(PS4_RX) + 15);
	wait(20);
	set_val(PS4_RY, get_val(PS4_RY) + 15);
	wait(20);
	set_val(PS4_RX, get_val(PS4_RX) - 15);
	wait(20);
	set_val(PS4_RY, get_val(PS4_RY) - 15);
	wait(20);
}
