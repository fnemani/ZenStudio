// ============================================================================
// 🎮 WARZONE GPC PRO | PS5 DUALSENSE EDITION (VERSION 4.0 - SPEED BUILD)
// 🕹️ Layout: Stick & Bewegung (Stick & Move) -> R3 = Jump, Kreis = Crouch
// ============================================================================
int current_weapon = 0;
int recoil_MP = 20;
int recoil_AR = 25;
int aim_assist = 1;
int active_recoil;
int final_recoil;

define DEADZONE = 10;

init {
	update_feedback();
}

main {
	// ------------------------------------------------------------------------
	// 1. Hair Triggers (Maximaler Output bei minimalem Drücken)
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) > DEADZONE) {
		set_val(PS4_L2, 100);
	}

	if (get_val(PS4_R2) > DEADZONE) {
		set_val(PS4_R2, 100);
	}

	// ------------------------------------------------------------------------
	// 2. Aggressiver Auto-Tac-Sprint & Sniper-Breath
	// ------------------------------------------------------------------------
	// Blockiert den Sprint beim Zielen/Schießen, um Abbrüche zu vermeiden
	if (get_val(PS4_LY) < -60 && !get_val(PS4_L2) && !get_val(PS4_R2)) {
		set_val(PS4_L3, 100);
	}

	// Auto-Breath beim Visieren
	if (get_val(PS4_L2)) {
		set_val(PS4_L3, 100);
	}

	// ------------------------------------------------------------------------
	// 3. Zero-Lag Weapon Tracking (Optimierte Logik)
	// ------------------------------------------------------------------------
	if (event_press(PS4_TRIANGLE)) {
		if (get_val(PS4_L2)) {
			// Resync auf MP (Primär)
			current_weapon = 0;
			set_val(PS4_TRIANGLE, 0);
		}
		else {
			// Normaler Wechsel
			current_weapon = !current_weapon;
		}

		update_feedback();
	}

	// ------------------------------------------------------------------------
	// 4. Dynamic Clamped Anti-Recoil (CPU-freundlicher berechnet)
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && get_val(PS4_R2)) {
		active_recoil = (current_weapon == 0) ? recoil_MP : recoil_AR;

		if (abs(get_val(PS4_RY)) < active_recoil + 15) {
			final_recoil = get_val(PS4_RY) + active_recoil;

			// Clamping in einer Zeile (verhindert Engine-Bugs)
			if (final_recoil > 100) {
				final_recoil = 100;
			}
			else if (final_recoil < -100) {
				final_recoil = -100;
			}

			set_val(PS4_RY, final_recoil);
		}
	}

	// ------------------------------------------------------------------------
	// 5. Auto-Ping (Optimiert, damit der erste Schuss nicht ruckelt)
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && event_press(PS4_R2)) {
		combo_run(AutoPing);
	}

	// ------------------------------------------------------------------------
	// 6. Smart Aim Assist & Hip-Fire Boost
	// ------------------------------------------------------------------------
	if (aim_assist) {
		if (get_val(PS4_L2) && abs(get_val(PS4_RX)) < 30 && abs(get_val(PS4_RY)) < 30) {
			combo_run(RotationalAA);
		}

		if (get_val(PS4_R2) && !get_val(PS4_L2)) {
			combo_run(HipfireStrafe);
		}
	}

	// ------------------------------------------------------------------------
	// 7. Aggressive Movement Systems (Modern WZ Mechanics)
	// ------------------------------------------------------------------------
	// Slide Cancel (Slide -> Jump) + B-Hop
	if (event_press(PS4_CIRCLE) && get_val(PS4_LY) < -60) {
		combo_run(ModernSlideCancel);
	}

	// Insta-Drop-Shot
	if (get_val(PS4_R2) && event_press(PS4_CIRCLE)) {
		combo_run(DropShot);
	}

	// Camera-Breaker (Aim Release Strafe)
	if (get_val(PS4_R2) && event_release(PS4_L2)) {
		combo_run(StrafeJump);
	}
}

// ============================================================================
// 🧠 FUNKTIONEN
// ============================================================================
function update_feedback() {
	set_led(LED_1, current_weapon == 0); // Blau wenn 0
	set_led(LED_2, current_weapon == 1); // Rot wenn 1
	set_led(LED_3, 0);
	set_led(LED_4, 0);
}

// ============================================================================
// ⚡ COMBOS
// ============================================================================
combo AutoPing {
	set_val(PS4_UP, 100);
	wait(20); // Verkürzt, um Input-Lag beim Feuern zu verhindern
	set_val(PS4_UP, 0);
	wait(20);
}

combo ModernSlideCancel {
	// 1. Slide
	set_val(PS4_CIRCLE, 100);
	wait(120);
	set_val(PS4_CIRCLE, 0);
	wait(30);
	// 2. Cancel mit Jump (R3 bei Stick & Move)
	set_val(PS4_R3, 100);
	wait(80);
	set_val(PS4_R3, 0);
	wait(40);
	// 3. Optionaler B-Hop
	set_val(PS4_R3, 100);
	wait(80);
	set_val(PS4_R3, 0);
}

combo StrafeJump {
	set_val(PS4_LX, 100);
	set_val(PS4_R3, 100);
	wait(80);
	set_val(PS4_R3, 0);
}

combo DropShot {
	set_val(PS4_CIRCLE, 100);
	wait(350);
}

combo HipfireStrafe {
	set_val(PS4_LX, 100);
	wait(40);
	set_val(PS4_LX, -100);
	wait(40);
}

combo RotationalAA {
	// Engere und flüssigere Rotation für stärkeren Sticky-Aim
	set_val(PS4_RX, get_val(PS4_RX) + 18);
	wait(15);
	set_val(PS4_RY, get_val(PS4_RY) + 18);
	wait(15);
	set_val(PS4_RX, get_val(PS4_RX) - 18);
	wait(15);
	set_val(PS4_RY, get_val(PS4_RY) - 18);
	wait(15);
}
