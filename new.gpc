// ============================================================================
// 🎮 WARZONE GPC PRO | PS5 DUALSENSE EDITION (VERSION 5.1 - COMPILER FIX)
// 🕹️ Layout: Stick & Bewegung (Stick & Move) -> R3 = Jump, Kreis = Crouch
// ============================================================================
int current_weapon = 0;
int recoil_MP = 20;
int recoil_AR = 25;
int aim_assist = 1;
int active_recoil;
int final_recoil;

define DEADZONE = 10;

// ----------------------------------------------------------------------------
// OLED Strings (Verhindert "String literals not supported" Fehler)
// ----------------------------------------------------------------------------
const string msg_mp1 = " PROFIL: MP ";
const string msg_mp2 = " (SMG Mode) ";
const string msg_ar1 = " PROFIL: AR ";
const string msg_ar2 = " (Long Range)";

init {
	update_feedback();
}

main {
	// ------------------------------------------------------------------------
	// 1. Hair Triggers (Maximaler Output)
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) > DEADZONE) {
		set_val(PS4_L2, 100);
	}

	if (get_val(PS4_R2) > DEADZONE) {
		set_val(PS4_R2, 100);
	}

	// ------------------------------------------------------------------------
	// 2. Aggressiver Auto-Tac-Sprint & Sniper-Breath
	// ------------------------------------------------------------------------
	if (get_val(PS4_LY) < -60 && !get_val(PS4_L2) && !get_val(PS4_R2)) {
		set_val(PS4_L3, 100);
	}

	if (get_val(PS4_L2)) {
		set_val(PS4_L3, 100);
	}

	// ------------------------------------------------------------------------
	// 3. Zero-Lag Weapon Tracking & OLED Update
	// ------------------------------------------------------------------------
	if (event_press(PS4_TRIANGLE)) {
		if (get_val(PS4_L2)) {
			current_weapon = 0;
			set_val(PS4_TRIANGLE, 0);
		}
		else {
			current_weapon = !current_weapon;
		}

		update_feedback();
	}

	// ------------------------------------------------------------------------
	// 4. Dynamic Clamped Anti-Recoil
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && get_val(PS4_R2)) {
		active_recoil = (current_weapon == 0) ? recoil_MP : recoil_AR;

		if (abs(get_val(PS4_RY)) < active_recoil + 15) {
			final_recoil = get_val(PS4_RY) + active_recoil;

			if (final_recoil > 100) {
				final_recoil = 100;
			}
			else if (final_recoil < -100) {
				final_recoil = -100;
			}

			set_val(PS4_RY, final_recoil);
		}
	}

	// ------------------------------------------------------------------------
	// 5. Auto-Ping (First Shot)
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && event_press(PS4_R2)) {
		combo_run(AutoPing);
	}

	// ------------------------------------------------------------------------
	// 6. Circular Aim Assist (Smooth Tracking)
	// ------------------------------------------------------------------------
	if (aim_assist) {
		if (get_val(PS4_L2) && abs(get_val(PS4_RX)) < 40 && abs(get_val(PS4_RY)) < 40) {
			combo_run(CircularAA);
		}
		else if (combo_running(CircularAA)) {
			combo_stop(CircularAA);
		}

		if (get_val(PS4_R2) && !get_val(PS4_L2) && current_weapon == 0) {
			combo_run(HipfireStrafe);
		}
	}

	// ------------------------------------------------------------------------
	// 7. Aggressive Movement Systems
	// ------------------------------------------------------------------------
	if (event_press(PS4_CIRCLE) && get_val(PS4_LY) < -60) {
		combo_run(ModernSlideCancel);
	}

	if (get_val(PS4_R2) && event_press(PS4_CIRCLE)) {
		combo_run(DropShot);
	}

	if (get_val(PS4_R2) && event_release(PS4_L2)) {
		combo_run(StrafeJump);
	}

	// ------------------------------------------------------------------------
	// 8. Auto-Strafe mit "Smart Yield" (NUR FÜR MP/SMG)
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && get_val(PS4_R2) && current_weapon == 0) {
		if (abs(get_val(PS4_LX)) < 60) {
			combo_run(AutoStrafe);
		}
		else if (combo_running(AutoStrafe)) {
			combo_stop(AutoStrafe);
		}
	}
	else if (combo_running(AutoStrafe)) {
		combo_stop(AutoStrafe);
	}
}

// ============================================================================
// 🧠 FUNKTIONEN (LED & OLED FEEDBACK)
// ============================================================================
function update_feedback() {
	cls_oled(0);

	if (current_weapon == 0) {
		// Profil 0: MP (Blau)
		set_led(LED_1, 1);
		set_led(LED_2, 0);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
		// Wir nutzen print() und rufen das erste Zeichen [0] der String-Konstante ab
		print(25, 25, 0, 1, msg_mp1[0]);
		print(25, 40, 0, 1, msg_mp2[0]);
	}
	else {
		// Profil 1: AR (Rot)
		set_led(LED_1, 0);
		set_led(LED_2, 1);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
		print(25, 25, 0, 1, msg_ar1[0]);
		print(25, 40, 0, 1, msg_ar2[0]);
	}
}

// ============================================================================
// ⚡ COMBOS
// ============================================================================
combo AutoPing {
	set_val(PS4_UP, 100);
	wait(20);
	set_val(PS4_UP, 0);
	wait(20);
}

combo ModernSlideCancel {
	set_val(PS4_CIRCLE, 100);
	wait(120);
	set_val(PS4_CIRCLE, 0);
	wait(30);
	set_val(PS4_R3, 100);
	wait(80);
	set_val(PS4_R3, 0);
	wait(40);
	set_val(PS4_R3, 100);
	wait(80);
	set_val(PS4_R3, 0);
}

combo StrafeJump {
	set_val(PS4_LX, 100);
	set_val(PS4_R3, 100);
	wait(80);
	set_val(PS4_R3, 0);
}

combo DropShot {
	set_val(PS4_CIRCLE, 100);
	wait(350);
}

combo HipfireStrafe {
	set_val(PS4_LX, 100);
	wait(40);
	set_val(PS4_LX, -100);
	wait(40);
}

combo CircularAA {
	set_val(PS4_RY, get_val(PS4_RY) - 15);
	set_val(PS4_RX, get_val(PS4_RX) + 15);
	wait(15);
	set_val(PS4_RY, get_val(PS4_RY) + 15);
	set_val(PS4_RX, get_val(PS4_RX) + 15);
	wait(15);
	set_val(PS4_RY, get_val(PS4_RY) + 15);
	set_val(PS4_RX, get_val(PS4_RX) - 15);
	wait(15);
	set_val(PS4_RY, get_val(PS4_RY) - 15);
	set_val(PS4_RX, get_val(PS4_RX) - 15);
	wait(15);
}

combo AutoStrafe {
	set_val(PS4_LX, -100);
	wait(300);
	set_val(PS4_LX, 100);
	wait(300);
}
