// ============================================================================
// 🎮 WARZONE GPC PRO | REBIRTH QUADS EDITION V4
// 🕹️ Layout: Stick & Bewegung -> R3 = Jump, Kreis = Crouch/Slide
// ⚙️ Features: Y-Y Spam, Smart Plating, Directional L2-Release Jump
// ============================================================================
int current_weapon = 0; // 0 = MP (SMG), 1 = AR (Sturmgewehr)
int recoil_MP = 20;
int recoil_AR = 25;
int aim_assist = 1;
int active_recoil;
int final_recoil;
int plating_active = 0;
int jump_toggle = 100; // NEU: Steuert die Links/Rechts Sprungrichtung

define AA_POWER = 8;
define AA_DELAY = 12;

// ----------------------------------------------------------------------------
// OLED Strings
// ----------------------------------------------------------------------------
const string msg_mp1 = " PROFIL: MP ";
const string msg_mp2 = " (SMG + Jump) ";
const string msg_ar1 = " PROFIL: AR ";
const string msg_ar2 = " (Long Range) ";

init {
	update_feedback();
}

main {
	// ------------------------------------------------------------------------
	// 1. Instant Hair Triggers
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) > 0) {
		set_val(PS4_L2, 100);
	}

	if (get_val(PS4_R2) > 0) {
		set_val(PS4_R2, 100);
	}

	// ------------------------------------------------------------------------
	// 2. Y-Y Spam (Movement Flow)
	// ------------------------------------------------------------------------
	if (get_val(PS4_RIGHT)) {
		combo_run(YY_Spam);
	}

	// ------------------------------------------------------------------------
	// 3. Smart Weapon Tracking (Anti-Desync Fix)
	// ------------------------------------------------------------------------
	if (event_release(PS4_TRIANGLE) && get_ptime(PS4_TRIANGLE) < 300 && !combo_running(YY_Spam)) {
		if (get_val(PS4_L2)) {
			current_weapon = 0;
		}
		else {
			current_weapon = !current_weapon;
		}

		update_feedback();
	}

	// ------------------------------------------------------------------------
	// 4. Dynamic Anti-Recoil
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && get_val(PS4_R2)) {
		active_recoil = (current_weapon == 0) ? recoil_MP : recoil_AR;

		if (abs(get_val(PS4_RY)) < active_recoil + 15) {
			final_recoil = get_val(PS4_RY) + active_recoil;

			if (final_recoil > 100) {
				final_recoil = 100;
			}
			else if (final_recoil < -100) {
				final_recoil = -100;
			}

			set_val(PS4_RY, final_recoil);
		}
	}

	// ------------------------------------------------------------------------
	// 5. Auto-Ping beim ersten Schuss
	// ------------------------------------------------------------------------
	if (get_val(PS4_L2) && event_press(PS4_R2)) {
		combo_run(AutoPing);
	}

	// ------------------------------------------------------------------------
	// 6. Micro-Dynamic Aim Assist
	// ------------------------------------------------------------------------
	if (aim_assist && get_val(PS4_L2)) {
		if (abs(get_val(PS4_RX)) < 25 && abs(get_val(PS4_RY)) < 25) {
			combo_run(MicroStickyAA);
		}
		else if (combo_running(MicroStickyAA)) {
			combo_stop(MicroStickyAA);
		}
	}
	else if (combo_running(MicroStickyAA)) {
		combo_stop(MicroStickyAA);
	}

	// ------------------------------------------------------------------------
	// 7. Aggressive Movement (Slide Cancel & Drop/Jump Shots)
	// ------------------------------------------------------------------------
	if (event_press(PS4_CIRCLE) && get_val(PS4_LY) < -60) {
		combo_run(ModernSlideCancel);
	}

	if (get_val(PS4_R2) && event_press(PS4_CIRCLE)) {
		combo_run(DropShot);
	}

	if (current_weapon == 0 && get_val(PS4_L2) && event_press(PS4_R2)) {
		combo_run(SMGJumpShot);
	}

	// ------------------------------------------------------------------------
	// 8. NEU: Directional L2-Release Jump (Links/Rechts Ausweichen)
	// ------------------------------------------------------------------------
	if (get_val(PS4_R2) && event_release(PS4_L2)) {
		// Prüfen der aktuellen Stick-Richtung
		if (get_val(PS4_LX) < -30) {
			jump_toggle = -100; // Spieler lenkt nach links -> Springe links
		}
		else if (get_val(PS4_LX) > 30) {
			jump_toggle = 100; // Spieler lenkt nach rechts -> Springe rechts
		}
		else {
			// Spieler steht still -> wechsle Richtung automatisch ab (Zick-Zack)
			jump_toggle = jump_toggle * -1;
		}

		combo_run(DirectionalQuickJump);
	}

	// ------------------------------------------------------------------------
	// 9. Auto-Plating Evasion (Ausweichen beim Heilen)
	// ------------------------------------------------------------------------
	if (get_val(PS4_TRIANGLE) && get_ptime(PS4_TRIANGLE) > 300) {
		plating_active = 1;
	}

	if (plating_active) {
		combo_run(EvasivePlating);
	}

	if (get_val(PS4_L2) || get_val(PS4_R2)) {
		plating_active = 0;
		combo_stop(EvasivePlating);
	}
}

// ============================================================================
// 🧠 FUNKTIONEN (LED & OLED FEEDBACK)
// ============================================================================
function update_feedback() {
	cls_oled(0);

	if (current_weapon == 0) {
		set_led(LED_1, 1);
		set_led(LED_2, 0);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
		print(25, 20, 0, 1, msg_mp1[0]);
		print(15, 38, 0, 1, msg_mp2[0]);
	}
	else {
		set_led(LED_1, 0);
		set_led(LED_2, 1);
		set_led(LED_3, 0);
		set_led(LED_4, 0);
		print(25, 20, 0, 1, msg_ar1[0]);
		print(15, 38, 0, 1, msg_ar2[0]);
	}
}

// ============================================================================
// ⚡ COMBOS
// ============================================================================
combo AutoPing {
	set_val(PS4_UP, 100);
	wait(20);
	set_val(PS4_UP, 0);
	wait(20);
}

combo ModernSlideCancel {
	set_val(PS4_CIRCLE, 100);
	wait(90);
	set_val(PS4_CIRCLE, 0);
	wait(25);
	set_val(PS4_R3, 100);
	wait(70);
	set_val(PS4_R3, 0);
	wait(35);
	set_val(PS4_R3, 100);
	wait(70);
	set_val(PS4_R3, 0);
	wait(35);
	set_val(PS4_R3, 100);
	wait(70);
	set_val(PS4_R3, 0);
	wait(35);
	set_val(PS4_R3, 100);
	wait(70);
	set_val(PS4_R3, 0);
}

combo DropShot {
	set_val(PS4_CIRCLE, 100);
	wait(350);
}

combo SMGJumpShot {
	wait(40);
	set_val(PS4_R3, 100);
	wait(70);
	set_val(PS4_R3, 0);
}

// NEU: Seitwärtssprung (Links/Rechts)
combo DirectionalQuickJump {
	set_val(PS4_LX, jump_toggle); // Drückt den linken Stick hart in die berechnete Richtung
	set_val(PS4_R3, 100);
	wait(100); // 100ms reicht für einen sauberen, weiten Sprung
	set_val(PS4_LX, jump_toggle);
	set_val(PS4_R3, 0);
}

combo MicroStickyAA {
	set_val(PS4_RY, get_val(PS4_RY) + AA_POWER);
	wait(AA_DELAY);
	set_val(PS4_RX, get_val(PS4_RX) + AA_POWER);
	wait(AA_DELAY);
	set_val(PS4_RY, get_val(PS4_RY) - AA_POWER);
	wait(AA_DELAY);
	set_val(PS4_RX, get_val(PS4_RX) - AA_POWER);
	wait(AA_DELAY);
}

combo YY_Spam {
	set_val(PS4_TRIANGLE, 100);
	wait(25);
	set_val(PS4_TRIANGLE, 0);
	wait(25);
	set_val(PS4_TRIANGLE, 100);
	wait(25);
	set_val(PS4_TRIANGLE, 0);
	wait(25);
}

combo EvasivePlating {
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
	wait(550);
	set_val(PS4_CIRCLE, 100);
	wait(50);
	set_val(PS4_CIRCLE, 0);
	wait(550);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
	wait(550);
	set_val(PS4_CIRCLE, 100);
	wait(50);
	set_val(PS4_CIRCLE, 0);
	wait(550);
	set_val(PS4_R3, 100);
	wait(50);
	set_val(PS4_R3, 0);
	wait(550);
	plating_active = 0;
}
