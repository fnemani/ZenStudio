/* ========================================================================
   Warzone GPC Script - V3.0 (FIXED & OPTIMIZED)
   Layout: Stick & Bewegung | Clean Micro-Movements
======================================================================== */
const string BOOT_MSG1 = "V3.0 FIXED";
const string BOOT_MSG2 = "BY FAWI";
const string MSG_WEAPON_MP = "WAFFE: MP";
const string MSG_WEAPON_AR = "WAFFE: AR";

// --- Button Mappings – PS5 ---
define ADS = XB1_LT;
define FIRE = XB1_RT;
define SPRINT = XB1_LS;
define RX = XB1_RX;
define RY = XB1_RY;
define LX = XB1_LX;
define LY = XB1_LY;
define CROUCH = XB1_B;
define JUMP = XB1_RS;
define MELEE = XB1_A;
define RELOAD = XB1_X;
define SWAP_BTN = XB1_Y;
define PING = XB1_UP;

// --- Konstanten & Toggles ---
define STICK_MAX = 100;
define STICK_MIN = -100;
define TRIGGER_DZ = 5;

int AutoBreath_Toggle = TRUE;
int Strafe_Toggle = TRUE;
int AR_Toggle = TRUE;
int AutoRun_Toggle = TRUE;
int Slide_Toggle = TRUE;
int RapidFire_Toggle = FALSE;
int AutoPing_Toggle = TRUE;

// --- WAFFEN PROFILE ---
int MP_Recoil = 19;
int AR_Recoil = 26;
int Active_Recoil = 20;
int is_secondary = FALSE;

// --- Aim Assist Settings (Optimiert) ---
int AR_Release = 85;       // Erhöht, damit Anti-Recoil beim Tracking nicht sofort abbricht
int AA_Size = 14;          // Feinerer Wert gegen Verziehen
int AA_Speed = 15;
int Strafe_AA_Size = 16;
int Strafe_AA_Speed = 20;
int RF_Hold = 30;
int RF_Release = 30;

// --- State Cache & Calculation Variables ---
int ads_on;
int fire_on;
int ly_in;
int lx_in;
int rx_in;
int ry_in;
int rx_abs;
int ry_abs;
int was_ads_and_fire = FALSE;
int jump_direction = 100;
int final_rx;
int final_ry;
int aa_index = 0;

function clamp_stick(val) {
	if (val > STICK_MAX) return STICK_MAX;
	if (val < STICK_MIN) return STICK_MIN;
	return val;
}

init {
	cls_oled(0);
	print(24, 5, 0, 1, BOOT_MSG1[0]);
	print(36, 25, 0, 1, BOOT_MSG2[0]);
	print(30, 45, 0, 1, MSG_WEAPON_MP[0]);
}

main {
	// =========================================================
	// --- 1. ZENTRALES CACHING ---
	// =========================================================
	ads_on = (get_val(ADS) > TRIGGER_DZ);
	fire_on = (get_val(FIRE) > TRIGGER_DZ);
	ly_in = get_val(LY);
	lx_in = get_val(LX);
	rx_in = get_val(RX);
	ry_in = get_val(RY);
	rx_abs = abs(rx_in);
	ry_abs = abs(ry_in);

	// =========================================================
	// --- SMART WEAPON TRACKING (OLED) ---
	// =========================================================
	if (event_press(SWAP_BTN) && !ads_on) {
		is_secondary = !is_secondary;
		cls_oled(0);
		print(24, 5, 0, 1, BOOT_MSG1[0]);
		print(36, 25, 0, 1, BOOT_MSG2[0]);

		if (is_secondary) {
			Active_Recoil = AR_Recoil;
			print(30, 45, 0, 1, MSG_WEAPON_AR[0]);
		} else {
			Active_Recoil = MP_Recoil;
			print(30, 45, 0, 1, MSG_WEAPON_MP[0]);
		}
	}

	if (ads_on && event_press(SWAP_BTN)) {
		is_secondary = FALSE;
		Active_Recoil = MP_Recoil;
		set_val(SWAP_BTN, 0);
		cls_oled(0);
		print(24, 5, 0, 1, BOOT_MSG1[0]);
		print(36, 25, 0, 1, BOOT_MSG2[0]);
		print(30, 45, 0, 1, MSG_WEAPON_MP[0]);
	}

	// =========================================================
	// --- AGGRESSIVE MOVEMENT ---
	// =========================================================
	if (AutoRun_Toggle && ly_in < -50 && !ads_on && !fire_on && !get_val(RELOAD) && !combo_running(Fast_Slide_Cancel)) {
		set_val(SPRINT, STICK_MAX);
	}

	if (event_press(CROUCH) && ly_in < -50 && Slide_Toggle) {
		combo_run(Fast_Slide_Cancel);
	}

	if (get_val(JUMP) && !combo_running(Fast_Slide_Cancel)) {
		combo_run(B_Hop_Combo);
	} else if (!combo_running(Fast_Slide_Cancel)) {
		combo_stop(B_Hop_Combo);
	}

	if (ads_on && fire_on) {
		was_ads_and_fire = TRUE;
	} else if (!ads_on && fire_on && was_ads_and_fire) {
		was_ads_and_fire = FALSE;
		jump_direction = (jump_direction == 100) ? -100 : 100;
		combo_run(Auto_Strafe_Jump);
	} else if (!fire_on) {
		was_ads_and_fire = FALSE;
	}

	// =========================================================
	// --- UTILITY (AUTO-PING) ---
	// =========================================================
	if (AutoPing_Toggle && ((ads_on && event_press(FIRE)) || (fire_on && event_press(ADS)))) {
		combo_run(Auto_Ping_Combo);
	}

	// =========================================================
	// --- TRIGGER & RAPID FIRE ---
	// =========================================================
	if (ads_on) set_val(ADS, STICK_MAX);
	if (fire_on) {
		if (RapidFire_Toggle) combo_run(Rapid_Fire_Combo);
		else set_val(FIRE, STICK_MAX);
	} else {
		combo_stop(Rapid_Fire_Combo);
	}

	// =========================================================
	// --- AIM ASSIST & DYNAMIC ANTI-RECOIL (FIXED LOOP) ---
	// =========================================================
	final_rx = rx_in;
	final_ry = ry_in;

	if (ads_on) {
		// Rotational Micro-Movements direkt berechnen
		if (rx_abs < AR_Release && ry_abs < AR_Release) {
			if (combo_running(Rotational_AA)) {
				// Nutzt den Timer-Schritt der Combo für flüssigen Micro-Aim
				if (aa_index == 0)      { final_rx += 0;       final_ry += AA_Size; }
				else if (aa_index == 1) { final_rx += AA_Size; final_ry += (AA_Size/2); }
				else if (aa_index == 2) { final_rx += AA_Size; final_ry += 0; }
				else if (aa_index == 3) { final_rx += AA_Size; final_ry -= (AA_Size/2); }
				else if (aa_index == 4) { final_rx += 0;       final_ry -= AA_Size; }
				else if (aa_index == 5) { final_rx -= AA_Size; final_ry -= (AA_Size/2); }
				else if (aa_index == 6) { final_rx -= AA_Size; final_ry += 0; }
				else if (aa_index == 7) { final_rx -= AA_Size; final_ry += (AA_Size/2); }
			} else {
				combo_run(Rotational_AA);
			}
		}

		// Anti-Recoil greift beim Schießen
		if (AR_Toggle && fire_on) {
			if (rx_abs < AR_Release && ry_abs < AR_Release) {
				final_ry += Active_Recoil; // Zieht den Stick nach unten ausgleichnd
			}
		}

		// Stick-Werte sicher an die Konsole senden
		set_val(RX, clamp_stick(final_rx));
		set_val(RY, clamp_stick(final_ry));
	} else {
		combo_stop(Rotational_AA);
	}

	// =========================================================
	// --- STRAFE AA & AUTOBREATH ---
	// =========================================================
	if (Strafe_Toggle && (ads_on || fire_on) && abs(ly_in) < 40 && abs(lx_in) < 40) {
		combo_run(Strafe_AA);
	} else {
		combo_stop(Strafe_AA);
	}

	if (AutoBreath_Toggle && ads_on && !fire_on) {
		combo_run(AutoBreath_Combo);
	} else {
		combo_stop(AutoBreath_Combo);
	}
}

// =========================================================
// --- COMBOS ---
// =========================================================
combo Fast_Slide_Cancel {
	set_val(CROUCH, STICK_MAX);
	wait(80);
	set_val(CROUCH, 0);
	wait(40);
	set_val(JUMP, STICK_MAX);
	wait(40);
	set_val(JUMP, 0);
}

combo B_Hop_Combo {
	set_val(JUMP, STICK_MAX);
	wait(40);
	set_val(JUMP, 0);
	wait(60);
}

combo Auto_Ping_Combo {
	set_val(PING, STICK_MAX);
	wait(60);
	set_val(PING, 0);
	wait(50);
	set_val(PING, STICK_MAX);
	wait(60);
	set_val(PING, 0);
	wait(1300);
}

combo Auto_Strafe_Jump {
	set_val(LX, jump_direction);
	set_val(JUMP, STICK_MAX);
	wait(120);
	set_val(LX, jump_direction);
	set_val(JUMP, 0);
	wait(150);
}

combo Rapid_Fire_Combo {
	set_val(FIRE, STICK_MAX);
	wait(RF_Hold);
	set_val(FIRE, 0);
	wait(RF_Release);
}

// Steuert den Takt für die Aim-Assist-Mikrobewegungen
combo Rotational_AA {
	wait(AA_Speed);
	aa_index = (aa_index + 1) & 7;
}

combo Strafe_AA {
	set_val(LX, clamp_stick(lx_in + Strafe_AA_Size));
	wait(Strafe_AA_Speed);
	set_val(LX, clamp_stick(lx_in - Strafe_AA_Size));
	wait(Strafe_AA_Speed);
}

combo AutoBreath_Combo {
	wait(150);
	set_val(SPRINT, STICK_MAX);
	wait(4000);
}